# ============================================
# PataPlan - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Database ----
POSTGRES_USER=pataplan
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=pataplan

# Connection string used by Prisma / server
# In Docker: host is the service name "db"
# Local: host is "localhost"
DATABASE_URL=postgresql://pataplan:change-me-in-production@db:5432/pataplan

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Authentication (JWT) ----
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173

# ---- File Uploads ----
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=uploads

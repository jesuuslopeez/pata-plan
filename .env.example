# ============================================
# PataPlan - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Database ----
POSTGRES_USER=pataplan
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=pataplan

# Connection string used by Prisma / server
# In Docker: host is the service name "db"
# Local: host is "localhost"
DATABASE_URL=postgresql://pataplan:change-me-in-production@db:5432/pataplan

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Authentication (JWT) ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS ----
# In production point this to your public frontend URL (e.g. https://pataplan.example.com)
CORS_ORIGIN=http://localhost:5173

# ---- File Uploads ----
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=uploads

# ---- SMTP / Email ----
# Used for account verification, password reset and event reminders.
# For Gmail use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="PataPlan <your-email@gmail.com>"

# Base URLs included in transactional emails. Point to the public frontend.
VERIFY_URL_BASE=http://localhost:5173/verify-email
RESET_URL_BASE=http://localhost:5173/reset-password

# ---- Scheduled notifications ----
# Daily job that emails owners about upcoming, due and overdue health events.
# Set NOTIFICATIONS_ENABLED=false to disable the scheduler entirely.
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_CRON=0 9 * * *
NOTIFICATIONS_TIMEZONE=Europe/Madrid

# Manual trigger endpoint (POST /api/dev/notifications/run) is only exposed
# when this token is set. Use a long random value and send it as the
# x-trigger-token header.
NOTIFICATIONS_TRIGGER_TOKEN=

# ---- Frontend (Vite) ----
# Base URL the SPA uses to reach the API. Behind a reverse proxy this is "/api".
VITE_API_URL=http://localhost:3000/api

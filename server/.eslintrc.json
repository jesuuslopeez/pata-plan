{
  "env": {
    "node": true,
    "es2024": true
  },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^(next|req|res|_)" }],
    "no-console": "warn",
    "eqeqeq": "error",
    "curly": "error"
  },
  "overrides": [
    {
      "files": ["src/tests/**/*.js", "src/utils/__mocks__/**/*.js"],
      "env": {
        "jest": true
      }
    }
  ]
}
